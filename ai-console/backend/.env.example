# 后端环境变量示例（拷贝为 .env 并按需修改）
# 本文件不包含数据库 URL、SECRET_KEY 等敏感项（见 secrets 仓库或部署脚本）。

# ----- traffic-api 集成（外部纯推理服务）-----
# Base URL：traffic-api 监听地址。Docker 默认 10000；严禁与本后端 10088 冲突。
TRAFFIC_API_BASE_URL=http://127.0.0.1:10000
# 设备面鉴权 token：我们的后端 → traffic-api 每个调用带 Authorization: Bearer <此值>。
# 部署时务必替换为强随机串；可执行：python -c "import secrets; print(secrets.token_urlsafe(48))"
TRAFFIC_API_AUTH_TOKEN=traffic-api-token-change-me-in-production
# 默认 callback_url：traffic-api 子进程推送结果的目标地址（SSRF 防护要求必须公网）。
# 本地开发可留空字符串，traffic-api 不推送，事件由用户后端单独同步到我们的库。
TRAFFIC_API_DEFAULT_CALLBACK_URL=
# 单次 HTTP 请求超时（秒）。
TRAFFIC_API_REQUEST_TIMEOUT=30.0
