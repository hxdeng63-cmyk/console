remote-api-response.network-response
screenshot-expand.cjs

# Photo-videos content (kept outside git; whitelist .gitkeep for directory placeholders)
data/photo-videos/*/
data/photo-videos/*/*/
data/photo-videos/*/*/*/
!data/photo-videos/*/.gitkeep
!data/photo-videos/*/*/.gitkeep
!data/photo-videos/*/*/*/.gitkeep

# Monitoring (active camera source video, large files; whitelist .gitkeep only)
data/monitoring/*
!data/monitoring/.gitkeep

# Archive (no gitkeep, fully gitignored)
data/archive/

# Backups
.omc/backups/media-pre-migration-*.tar.gz
.omc/backups/.migration_log.jsonl
